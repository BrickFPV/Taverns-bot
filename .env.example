# Bot token'ını buraya yapıştır
BOT_TOKEN=buraya_token_yapistir

# Komut prefix'i (varsayılan: !)
BOT_PREFIX=!

# OmniRoute / Yerel Yapay Zeka Ayarları
AI_BASE_URL=http://hermes.local:20128/v1
AI_API_KEY=omniroute
AI_MODEL=Freecombo

# Yerel yönetim paneli
# 0.0.0.0 = aynı Wi-Fi/LAN'daki cihazlardan erişim
# 127.0.0.1 = yalnızca çalışan bilgisayar
GUI_HOST=0.0.0.0
GUI_PORT=8787
GUI_PASSWORD=buraya_gui_sifresi
